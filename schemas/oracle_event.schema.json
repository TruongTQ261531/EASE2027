      "title": "Causal Root Cause",
      "type": "string"
    },
    "label_confidence": {
      "enum": [
        "medium",
        "low"
      ],
      "title": "Label Confidence",
      "type": "string"
    },
    "requested_start_ms": {
      "title": "Requested Start Ms",
      "type": "number"
    },
    "requested_end_ms": {
      "title": "Requested End Ms",
      "type": "number"
    },
    "actual_start_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actual Start Ms"
    },
    "actual_end_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actual End Ms"
    },
    "measurements": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
