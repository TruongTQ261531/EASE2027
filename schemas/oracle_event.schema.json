  "required": [
    "run_id",
    "session_id",
    "requested_condition",
    "verification_status",
    "verified_condition",
    "observed_degradation",
    "label_confidence",
    "requested_start_ms",
    "requested_end_ms",
    "actual_start_ms",
    "actual_end_ms",
    "measurements",
    "evidence_paths",
    "limitation"
