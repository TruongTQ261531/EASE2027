    "verification_status": {
      "enum": [
        "verified",
        "failed",
        "ambiguous"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "verified_condition": {
      "anyOf": [
        {
          "enum": [
            "normal",
            "capture_pause",
            "connection_close"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Verified Condition"
    },
    "observed_degradation": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "title": "Observed Degradation",
      "type": "string"
    },
    "causal_root_cause": {
      "const": "unestablished",
