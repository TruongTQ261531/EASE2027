      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "requested_condition": {
      "enum": [
        "normal",
        "capture_pause",
        "connection_close"
      ],
